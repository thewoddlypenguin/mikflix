# Mikflix environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- TMDb enrichment (not required for local browsing) ----------------------
# API key (v3 auth) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional. Bearer token (v4 auth) if you prefer token auth to the API key.
# When set, it takes precedence over TMDB_API_KEY.
TMDB_READ_TOKEN=

# --- Admin screen (src/screens/Admin.tsx) -----------------------------------
# Password for /admin. Leave empty to keep the gate open (dev convenience only).
VITE_ADMIN_PASSWORD=

# --- Future integrations ----------------------------------------------------
# Base URL of a hosted Mikflix API, if one is deployed (leave empty for local).
MIKFLIX_API_URL=
